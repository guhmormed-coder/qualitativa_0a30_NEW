# Copie para .env e preencha as chaves dos detectores que você quiser consultar.
# Qualquer chave ausente simplesmente faz aquele detector ser removido do relatório;
# você ainda terá escores de quaisquer detectores que estiverem configurados.
#
# Para um teste offline sem nenhuma chave: passe --demo para o script.

GPTZERO_API_KEY=
ORIGINALITY_API_KEY=
ZEROGPT_API_KEY=
SAPLING_API_KEY=

# O Copyleaks precisa de ambos os campos:
COPYLEAKS_API_KEY=
COPYLEAKS_EMAIL=
