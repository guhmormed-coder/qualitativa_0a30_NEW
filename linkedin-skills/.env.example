# ─────────────────────────────────────────────────────────────────
# Todas as variáveis abaixo são OPCIONAIS.
# As skills funcionam em modo apenas-rascunho sem nada configurado.
# Adicione uma PUBLORA_API_KEY para habilitar a publicação automática na aprovação.
# ─────────────────────────────────────────────────────────────────

# Chave de API do Publora — cadastre-se grátis em https://app.publora.com/signup
# 15 posts de LinkedIn + Bluesky/mês no plano gratuito
PUBLORA_API_KEY=sk_your_key_here

# ID de conexão da plataforma LinkedIn (formato: linkedin-ABC123)
# Encontre isso no painel do Publora: Channels → sua conta do LinkedIn
LINKEDIN_PLATFORM_ID=linkedin-your_id_here

# ─────────────────────────────────────────────────────────────────
# Token do Apify (opcional) - permite que as skills busquem corpos de posts do
# LinkedIn, threads de comentário e os comentários recentes de um usuário sem
# cookies. O plano gratuito vem com $5/mês de crédito, o que rende bastante a
# $1-$5 por 1.000 resultados.
#
# Cadastro: https://console.apify.com/sign-up
# Token:    https://console.apify.com/settings/integrations
#
# Sem um token, as skills recorrem a pedir que você cole o texto do post
# ou as URLs de comentário manualmente.
# ─────────────────────────────────────────────────────────────────
APIFY_TOKEN=apify_api_your_token_here

# ─────────────────────────────────────────────────────────────────
# Token do Pixfaro (opcional) - permite que as skills gerem ilustrações para
# posts (imagens de feed, slides de carrossel, cards de citação) e as anexem
# ao publicar. Retorna uma URL hospedada que vai direto para a mídia do Publora.
# A sobreposição de texto/logo pixel a pixel mantém todo ativo alinhado com a marca.
#
# Cadastro + documentação: https://pixfaro.com  (formato da chave: pf_live_...)
#
# Sem um token, as skills redigem o prompt da imagem e pedem que você mesmo
# a gere e cole a URL.
# ─────────────────────────────────────────────────────────────────
PIXFARO_TOKEN=pf_live_your_token_here

# ─────────────────────────────────────────────────────────────────
# Avançado (Nível 2): se você construiu seu próprio publicador com Claude Code ou Codex,
# defina isto como o caminho de comando/módulo que as skills devem invocar na aprovação.
# Deixe sem definir a menos que você realmente tenha um publicador personalizado funcionando.
# ─────────────────────────────────────────────────────────────────
# LINKEDIN_SKILLS_CUSTOM_POSTER=python /path/to/my-poster.py
